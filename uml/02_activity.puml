@startuml
start
:Пользователь вводит параметры;
:Проверка SimulationConfig;
if (Параметры корректны?) then (да)
  :Создать Environment и разместить P/H/X;
  :Сохранить статистику шага 0;
  while (Симуляция не завершена?) is (да)
    if (Нажата пауза?) then (да)
      :Ожидать продолжения или одного шага;
    endif
    :Environment.step();
    :Все существовавшие P выполняют act();
    :H и X выполняют act() в случайном порядке;
    :Очистить погибших агентов;
    :Обновить поле и график P/H/X;
    if (Хотя бы один вид исчез?) then (да)
      :Остановить симуляцию;
      break
    endif
    if (Достигнут максимум шагов?) then (да)
      :Остановить симуляцию;
      break
    endif
  endwhile (нет)
  :Вывести итоговые показатели;
else (нет)
  :Показать ошибку параметров;
endif
stop
@enduml
