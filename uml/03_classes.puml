@startuml
skinparam classAttributeIconSize 0
hide empty members
abstract class Agent {
  # x : int
  # y : int
  # energy : int
  # alive : boolean
  + act(env: Environment) : void
  + getEnergy() : int
  + isAlive() : boolean
}
class Plant {
  - growthBuffer : double
  + act(env: Environment) : void
}
class Herbivore {
  + act(env: Environment) : void
}
class Predator {
  - herbivoreMemorySteps : int
  + act(env: Environment) : void
}
class Environment {
  - grid : Agent[][]
  - agents : List<Agent>
  - plantReproduceThreshold : int
  - herbivoreReproduceThreshold : int
  - predatorReproduceThreshold : int
  + step() : void
  + getAgent(x:int,y:int) : Agent
  + getPlantReproduceThreshold() : int
  + getHerbivoreReproduceThreshold() : int
  + getPredatorReproduceThreshold() : int
}
class SimulationConfig <<record>> {
  + width : int
  + height : int
  + plantEnergy : int
  + herbivoreEnergy : int
  + predatorEnergy : int
  + plantReproduceThreshold : int
  + herbivoreReproduceThreshold : int
  + predatorReproduceThreshold : int
}
class PopulationPoint <<record>> {
  + step : int
  + plants : int
  + herbivores : int
  + predators : int
}
class SimulationFactory {
  + create(config:SimulationConfig) : Environment
}
class SimulationController {
  - environment : Environment
  - config : SimulationConfig
  - timer : Timer
  + newSimulation(config:SimulationConfig) : void
  + start() : void
  + pause() : void
  + stepOnce() : void
}
interface SimulationListener
class SimulationFrame
class WorldPanel
class PopulationChartPanel
class Main
Agent <|-- Plant
Agent <|-- Herbivore
Agent <|-- Predator
Environment o-- "*" Agent
SimulationController --> Environment
SimulationController --> SimulationConfig
SimulationController ..> SimulationFactory
SimulationController ..> PopulationPoint
SimulationController --> SimulationListener
SimulationFrame ..|> SimulationListener
SimulationFrame *-- WorldPanel
SimulationFrame *-- PopulationChartPanel
SimulationFrame --> SimulationController
WorldPanel --> Environment
PopulationChartPanel o-- "*" PopulationPoint
Main ..> SimulationFrame
@enduml
